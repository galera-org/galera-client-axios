{
  "openapi": "3.1.0",
  "info": {
    "title": "galera",
    "description": "",
    "contact": {
      "name": "Ondřej Pešek",
      "email": "iTzBoboCz@users.noreply.github.com"
    },
    "license": { "name": "GPL-3.0-only", "identifier": "GPL-3.0-only" },
    "version": "0.1.0"
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/album": {
      "get": {
        "summary": "Retrieves a list of albums of an authenticated user",
        "operationId": "routes_get_album_list",
        "responses": {
          "200": {
            "description": "Album list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/AlbumResponse" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        },
        "security": [{ "BearerAuth": [] }]
      },
      "post": {
        "summary": "Creates a new album",
        "operationId": "routes_create_album",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AlbumInsertData" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Album created (or null on failure)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "type": "null" },
                    { "$ref": "#/components/schemas/AlbumResponse" }
                  ]
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/album/media": {
      "post": {
        "summary": "Adds media to an album",
        "operationId": "routes_album_add_media",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/AlbumAddMedia" }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": { "description": "Media added to album" },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/album/share/link/{album_share_link_uuid}": {
      "get": {
        "summary": "Gets basic information about album share link.",
        "operationId": "routes_get_album_share_link",
        "parameters": [
          {
            "name": "album_share_link_uuid",
            "in": "path",
            "description": "Album Share Link UUID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Share link info",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AlbumShareLinkBasic" }
              }
            }
          },
          "404": { "description": "Not found" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      },
      "put": {
        "summary": "Updates already existing album share link.",
        "operationId": "routes_update_album_share_link",
        "parameters": [
          {
            "name": "album_share_link_uuid",
            "in": "path",
            "description": "Album Share Link UUID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AlbumShareLinkInsert" }
            }
          },
          "required": true
        },
        "responses": {
          "200": { "description": "Album share link updated" },
          "204": { "description": "No changes" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      },
      "delete": {
        "summary": "Deletes an album share link.",
        "operationId": "routes_delete_album_share_link",
        "parameters": [
          {
            "name": "album_share_link_uuid",
            "in": "path",
            "description": "Album Share Link UUID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Album share link deleted" },
          "204": { "description": "Nothing deleted" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/album/{album_uuid}": {
      "put": {
        "summary": "Updates already existing album",
        "operationId": "routes_update_album",
        "parameters": [
          {
            "name": "album_uuid",
            "in": "path",
            "description": "Album UUID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AlbumUpdateData" }
            }
          },
          "required": true
        },
        "responses": {
          "200": { "description": "Album updated" },
          "204": { "description": "No changes" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Album not found" },
          "422": { "description": "Unprocessable entity" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      },
      "delete": {
        "summary": "Deletes an album",
        "operationId": "routes_delete_album",
        "parameters": [
          {
            "name": "album_uuid",
            "in": "path",
            "description": "Album UUID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Album deleted" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Album not found" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/album/{album_uuid}/media": {
      "get": {
        "summary": "Gets a list of media in an album",
        "operationId": "routes_get_album_structure",
        "parameters": [
          {
            "name": "album_uuid",
            "in": "path",
            "description": "Album UUID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Album media",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MediaResponse" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Album not found" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }, { "BasicSharedAlbumLinkAuth": [] }]
      }
    },
    "/album/{album_uuid}/share/link": {
      "get": {
        "summary": "Gets a list of album share links.",
        "operationId": "routes_get_album_share_links",
        "parameters": [
          {
            "name": "album_uuid",
            "in": "path",
            "description": "Album UUID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Album share links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SharedAlbumLinkResponse"
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Album not found" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      },
      "post": {
        "summary": "Creates a new album share link.",
        "operationId": "routes_create_album_share_link",
        "parameters": [
          {
            "name": "album_uuid",
            "in": "path",
            "description": "Album UUID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AlbumShareLinkInsert" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Share link created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SharedAlbumLinkResponse"
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Album not found" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/auth/oidc/{provider}/callback": {
      "get": {
        "operationId": "routes_oidc_callback",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "description": "OIDC provider key",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "code",
            "in": "query",
            "description": "Authorization code",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "state",
            "in": "query",
            "description": "CSRF state",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Authentication failed" },
          "404": { "description": "Provider not found" },
          "500": { "description": "Internal server error" },
          "503": { "description": "OIDC is disabled" }
        }
      }
    },
    "/auth/oidc/{provider}/login": {
      "get": {
        "operationId": "routes_oidc_login",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "description": "OIDC provider key",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "302": { "description": "Redirect to OIDC provider" },
          "404": { "description": "OIDC provider not found" },
          "503": { "description": "OIDC is disabled" }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "routes_health",
        "responses": { "200": { "description": "Health check passed" } }
      }
    },
    "/login": {
      "post": {
        "summary": "You must provide either a username or an email together with a password.",
        "operationId": "routes_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserLogin" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": { "description": "Invalid JSON or wrong shape" },
          "409": { "description": "Invalid credentials or user conflict" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/login/refresh": {
      "post": {
        "summary": "Refreshes sent token",
        "operationId": "routes_refresh_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ClaimsEncoded" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Token refreshed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClaimsEncoded" }
              }
            }
          },
          "400": { "description": "Invalid JSON or wrong shape" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/media": {
      "get": {
        "summary": "Gets a list of all media",
        "operationId": "routes_media_structure",
        "responses": {
          "200": {
            "description": "List of media",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MediaResponse" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/media/liked": {
      "get": {
        "summary": "Returns a list of liked media.",
        "operationId": "routes_get_media_liked_list",
        "responses": {
          "200": {
            "description": "Liked media",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MediaResponse" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/media/{media_uuid}": {
      "get": {
        "summary": "Returns a media",
        "operationId": "routes_get_media_by_uuid",
        "parameters": [
          {
            "name": "media_uuid",
            "in": "path",
            "description": "Media UUID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Binary media stream",
            "content": {
              "application/octet-stream": {
                "schema": { "$ref": "#/components/schemas/BinaryBody" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Media not found" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/media/{media_uuid}/description": {
      "put": {
        "summary": "Updates description of a media",
        "operationId": "routes_media_update_description",
        "parameters": [
          {
            "name": "media_uuid",
            "in": "path",
            "description": "Media UUID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MediaDescription" }
            }
          },
          "required": true
        },
        "responses": {
          "200": { "description": "Description updated" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Media not found" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      },
      "delete": {
        "summary": "Deletes description of a media",
        "operationId": "routes_media_delete_description",
        "parameters": [
          {
            "name": "media_uuid",
            "in": "path",
            "description": "Media UUID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Description deleted" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Media not found" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/media/{media_uuid}/like": {
      "post": {
        "summary": "Likes the media.",
        "operationId": "routes_media_like",
        "parameters": [
          {
            "name": "media_uuid",
            "in": "path",
            "description": "Media UUID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Liked a media" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Media not found" },
          "409": { "description": "Already liked" }
        },
        "security": [{ "BearerAuth": [] }]
      },
      "delete": {
        "summary": "Unlikes the media.",
        "operationId": "routes_media_unlike",
        "parameters": [
          {
            "name": "media_uuid",
            "in": "path",
            "description": "Media UUID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Unliked a media" },
          "204": { "description": "No changes made" },
          "404": { "description": "Media not found" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/public/config": {
      "get": {
        "summary": "Returns server configuration",
        "operationId": "routes_get_server_config",
        "responses": {
          "200": {
            "description": "Server config",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerConfigResponse"
                }
              }
            }
          }
        }
      }
    },
    "/scan_media": {
      "get": {
        "summary": "Searches for new media",
        "operationId": "routes_scan_media",
        "responses": {
          "200": { "description": "Scan started" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal server error" }
        },
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/system/info/public": {
      "get": {
        "summary": "Returns the public system information.",
        "operationId": "routes_system_info_public",
        "responses": {
          "200": {
            "description": "System info",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SystemInfoPublic" }
              }
            }
          }
        }
      }
    },
    "/user": {
      "post": {
        "summary": "Creates a new user",
        "operationId": "routes_create_user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewUser" }
            }
          },
          "required": true
        },
        "responses": {
          "200": { "description": "User created" },
          "400": { "description": "Invalid JSON or wrong shape" },
          "409": { "description": "User already exists" },
          "422": { "description": "Invalid user data" },
          "500": { "description": "Internal server error" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlbumAddMedia": {
        "type": "object",
        "required": ["album_uuid", "media_uuid"],
        "properties": {
          "album_uuid": { "type": "string" },
          "media_uuid": { "type": "string" }
        }
      },
      "AlbumInsertData": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "description": { "type": ["string", "null"] },
          "name": { "type": "string" }
        }
      },
      "AlbumResponse": {
        "type": "object",
        "required": ["owner_id", "name", "created_at", "link"],
        "properties": {
          "created_at": { "type": "string", "format": "date-time" },
          "description": { "type": ["string", "null"] },
          "link": { "type": "string" },
          "name": { "type": "string" },
          "owner_id": { "type": "integer", "format": "int32" },
          "thumbnail_link": { "type": ["string", "null"] }
        }
      },
      "AlbumShareLinkBasic": {
        "type": "object",
        "required": ["album_uuid", "is_password_protected", "is_expired"],
        "properties": {
          "album_uuid": { "type": "string" },
          "is_expired": { "type": "boolean" },
          "is_password_protected": { "type": "boolean" }
        }
      },
      "AlbumShareLinkInsert": {
        "type": "object",
        "properties": {
          "expiration": { "type": ["string", "null"], "format": "date-time" },
          "password": { "type": ["string", "null"] }
        }
      },
      "AlbumUpdateData": {
        "type": "object",
        "properties": {
          "description": { "type": ["string", "null"] },
          "name": { "type": ["string", "null"] }
        }
      },
      "AuthConfig": {
        "type": "object",
        "required": ["oidc", "policy"],
        "properties": {
          "oidc": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/OidcProviderPublic" }
          },
          "policy": { "$ref": "#/components/schemas/AuthPolicyPublic" }
        }
      },
      "AuthPolicyPublic": {
        "type": "object",
        "required": ["disable_local_signups", "disable_local_auth"],
        "properties": {
          "disable_local_auth": { "type": "boolean" },
          "disable_local_signups": { "type": "boolean" }
        }
      },
      "BinaryBody": { "type": "string", "format": "binary" },
      "ClaimsEncoded": {
        "type": "object",
        "description": "Encoded bearer token\n# Example\ndecode an encoded bearer token\n```\nlet encoded_token = Claims::new(1).encode().unwrap();\n\nlet decoded_token = encoded_token.decode();\n```",
        "required": ["encoded_claims"],
        "properties": { "encoded_claims": { "type": "string" } }
      },
      "LoginResponse": {
        "type": "object",
        "description": "Response when logging in.",
        "required": ["user_info", "bearer_token"],
        "properties": {
          "bearer_token": { "type": "string" },
          "user_info": { "$ref": "#/components/schemas/UserInfo" }
        }
      },
      "MediaDescription": {
        "type": "object",
        "properties": { "description": { "type": ["string", "null"] } }
      },
      "MediaResponse": {
        "type": "object",
        "required": ["filename", "owner_id", "width", "height", "uuid"],
        "properties": {
          "date_taken": { "type": ["string", "null"], "format": "date-time" },
          "description": { "type": ["string", "null"] },
          "filename": { "type": "string" },
          "height": { "type": "integer", "format": "int32", "minimum": 0 },
          "owner_id": { "type": "integer", "format": "int32" },
          "uuid": { "type": "string" },
          "width": { "type": "integer", "format": "int32", "minimum": 0 }
        }
      },
      "NewUser": {
        "type": "object",
        "description": "Struct for inserting new users.",
        "required": ["username", "email"],
        "properties": {
          "email": { "type": "string" },
          "password": { "type": ["string", "null"] },
          "username": { "type": "string" }
        }
      },
      "OidcProviderPublic": {
        "type": "object",
        "required": ["key", "display_name", "login_url"],
        "properties": {
          "display_name": { "type": "string" },
          "key": { "type": "string" },
          "login_url": { "type": "string" }
        }
      },
      "ServerConfigResponse": {
        "type": "object",
        "required": ["auth"],
        "properties": { "auth": { "$ref": "#/components/schemas/AuthConfig" } }
      },
      "SharedAlbumLinkResponse": {
        "type": "object",
        "required": ["uuid"],
        "properties": {
          "expiration": { "type": ["string", "null"], "format": "date-time" },
          "uuid": { "type": "string" }
        }
      },
      "SystemInfoPublic": {
        "type": "object",
        "required": [
          "operatingSystem",
          "serverName",
